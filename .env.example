# Copy to .env and replace each placeholder with a unique, randomly generated secret.
# These values configure Docker Compose; never commit the real .env file.
DB_ADMIN_PASSWORD=replace-with-a-long-random-admin-secret
DB_PASSWORD=replace-with-a-different-long-random-app-secret
DB_MIGRATION_PASSWORD=replace-with-a-different-long-random-migration-secret

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
SMTP_USER=
SMTP_PASS=
